{
  "manifest_version": 3,
  "name": "Manga Reader - Guardar capítulos",
  "version": "2.6.0",
  "description": "Guarda capítulos de manga como PDF o CBZ, y descarga series completas seleccionando capítulos.",
  "permissions": ["activeTab", "storage", "downloads", "contextMenus", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "48": "icons/icon48.png" }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }],
  "commands": {
    "save": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Guardar capítulo (PDF / CBZ / imágenes)"
    }
  },
  "icons": { "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
