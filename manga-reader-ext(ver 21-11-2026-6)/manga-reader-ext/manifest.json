{
  "manifest_version": 3,
  "name": "Manga Reader - Guardar capítulos",
  "version": "2.8.3",
  "description": "Guarda capítulos de manga como PDF, CBZ o imágenes, de a uno o varios seguidos, sin las páginas de publicidad.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage", "downloads", "contextMenus", "offscreen", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "48": "icons/icon48.png" }
  },
  "options_ui": { "page": "opciones.html", "open_in_tab": true },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["sagas.js", "content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }],
  "commands": {
    "save": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Guardar capítulo (PDF / CBZ / imágenes)"
    }
  },
  "icons": { "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
